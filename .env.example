# ── Auth (obbligatorio in produzione) ──
JWT_SECRET=cambia-questa-stringa-segreta-lunga-e-casuale

# URL pubblico dell'app (Render o dominio custom)
NEXT_PUBLIC_APP_URL=https://miodominio.it

# ── PostgreSQL (Render crea DATABASE_URL automaticamente da render.yaml) ──
# DATABASE_URL=postgresql://user:pass@host:5432/mizzli

# ── Storage foto — Supabase (consigliato) ──
# Crea un bucket pubblico "uploads" in Supabase Storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=uploads

# ── Storage foto — alternativa S3 / Cloudflare R2 ──
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://cdn.miodominio.it

# ── SMS (opzionale) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Google OAuth (opzionale) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
